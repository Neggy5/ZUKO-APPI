# ZUKO XMD V2 persistent storage
STORAGE_DIR=/app/storage
SESSION_DIR=/app/storage/session
DATA_DIR=/app/storage/data

# ── ZUKO subscriptions / billing ─────────────────────────────────
# Options: manual (default) or flutterwave
PAYMENT_PROVIDER=manual
PAYMENT_BASE_URL=https://your-public-railway-domain
PAYMENT_CURRENCY=NGN
PAYMENT_BUSINESS_NAME=ZUKO XMD
PAYMENT_SUPPORT_CONTACT=
BILLING_ADMIN_NUMBER=2349126933756

# Flutterwave automatic checkout
# Keep these secret; never commit real values.
FLW_SECRET_KEY=
FLW_SECRET_HASH=

PLAN_PRO_PRICE=1500
PLAN_ULTIMATE_PRICE=3000
PLAN_RESELLER_PRICE=5000

# Manual payment fallback
PREMIUM_PAY_NUMBER=8169946429
PREMIUM_PAY_NAME=Bassey Tabia precious
PREMIUM_PAY_METHOD=Opay

# Telegram pairing bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Gemini API (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
