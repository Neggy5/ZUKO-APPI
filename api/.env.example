NODE_ENV=production
PORT=3000
DATABASE_URL=${{Postgres.DATABASE_URL}}
ZUKO_ADMIN_PASSWORD=CHANGE_ME
ZUKO_ADMIN_SECRET=GENERATE_A_RANDOM_32_PLUS_CHAR_SECRET
SESSION_SECRET=GENERATE_A_DIFFERENT_RANDOM_32_PLUS_CHAR_SECRET
API_NAME=ZUKO API
API_VERSION=1.3.0
PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
CORS_ORIGIN=https://YOUR-RAILWAY-DOMAIN.up.railway.app

# Email verification via Resend
# Create the API key once at https://resend.com/api-keys and store it only in Railway Variables.
RESEND_API_KEY=
# Optional: use a verified domain sender in production. Defaults to Resend's onboarding sender for initial setup.
RESEND_FROM_EMAIL=ZUKO API <onboarding@resend.dev>
VERIFICATION_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=true

# Manual billing
BILLING_ADMIN_NUMBER=2349126933756
PREMIUM_PAY_METHOD=Opay
PREMIUM_PAY_NUMBER=8169946429
PREMIUM_PAY_NAME=Bassey Tabia precious
PLAN_PRO_PRICE=1500
PLAN_ULTIMATE_PRICE=3000
PLAN_BUSINESS_PRICE=5000

# Optional AI backend for /v1/ai/chat
AI_API_BASE=
AI_API_KEY=
AI_DEFAULT_MODEL=

# AI (server-side; never expose ATRIA_API_KEY to frontend/client code)
ATRIA_API_KEY=
AI_BASE_URL=https://api.atria-asi.ai/v1
AI_MODEL=Atria-Dawn-Preview
AI_TIMEOUT_MS=60000
AI_MAX_MESSAGE_CHARS=12000
AI_MAX_MESSAGES=20

YTDLP_IMPERSONATE=Chrome-131:Android-14

# YouTubeToolkit public resolver
YOUTUBETOOLKIT_BASE_URL=https://youtubetoolkit.com
YOUTUBETOOLKIT_TOOL_PATH=/tools/video-downloader-1080p
YOUTUBETOOLKIT_DOWNLOAD_API=video_fast
YOUTUBETOOLKIT_TIMEOUT_MS=45000

# Use yt-dlp if Save-Tube is unavailable
SAVETUBE_FALLBACK_YTDLP=1
