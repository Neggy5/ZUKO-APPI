SESSION_SECRET=GENERATE_A_DIFFERENT_RANDOM_32_PLUS_CHAR_SECRET
API_NAME=ZUKO API
API_VERSION=1.3.0
PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN.up.railway.app
CORS_ORIGIN=https://YOUR-RAILWAY-DOMAIN.up.railway.app

# Manual billing
BILLING_ADMIN_NUMBER=2349126933756
PREMIUM_PAY_METHOD=Opay
PREMIUM_PAY_NUMBER=8169946429
PREMIUM_PAY_NAME=Bassey Tabia precious
PLAN_PRO_PRICE=1500
PLAN_ULTIMATE_PRICE=3000
PLAN_BUSINESS_PRICE=5000

# Optional AI backend for /v1/ai/chat
AI_API_BASE=
AI_API_KEY=
AI_DEFAULT_MODEL=

# AI (server-side; never expose ATRIA_API_KEY to frontend/client code)
ATRIA_API_KEY=
AI_BASE_URL=https://api.atria-asi.ai/v1
AI_MODEL=Atria-Dawn-Preview
AI_TIMEOUT_MS=60000
AI_MAX_MESSAGE_CHARS=12000
AI_MAX_MESSAGES=20

YTDLP_IMPERSONATE=Chrome-131:Android-14

# Email verification via Resend (https://resend.com)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM=noreply@example.com

# Email verification settings
EMAIL_VERIFICATION_CODE_EXPIRY_MS=900000
EMAIL_VERIFICATION_RESEND_LIMIT_MS=60000

