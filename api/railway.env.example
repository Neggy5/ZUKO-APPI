DATABASE_URL=${{Postgres.DATABASE_URL}}
NODE_ENV=production
ZUKO_ADMIN_PASSWORD=CHANGE_ME
ZUKO_ADMIN_SECRET=GENERATE_A_RANDOM_SECRET_32_CHARS_MINIMUM
PUBLIC_BASE_URL=https://YOUR-RAILWAY-DOMAIN
CORS_ORIGIN=https://YOUR-RAILWAY-DOMAIN
API_NAME=ZUKO API
API_VERSION=1.0.0
# Downloader provider
DOWNLOADER_API_BASE=https://your-downloader-provider.example/api/download
DOWNLOADER_API_KEY=
DOWNLOADER_TIMEOUT_MS=45000

YTDLP_IMPERSONATE=Chrome-131:Android-14

# Email verification via Resend
# Create the API key once at https://resend.com/api-keys and store it only in Railway Variables.
RESEND_API_KEY=
# Optional: use a verified domain sender in production. Defaults to Resend's onboarding sender for initial setup.
RESEND_FROM_EMAIL=ZUKO API <onboarding@resend.dev>
VERIFICATION_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_REQUIRED=true
# YouTube video download queue
YT_VIDEO_CONCURRENCY_PER_KEY=2
YT_VIDEO_QUEUE_MAX_PER_KEY=24
YT_VIDEO_QUEUE_TIMEOUT_MS=180000

# YouTube video resolver timeouts (keep video requests below typical client timeouts)
YT_VIDEO_PROVIDER_TIMEOUT_MS=28000
YT_VIDEO_YTDLP_INSPECT_TIMEOUT_MS=28000
YT_VIDEO_RESOLVER_TIMEOUT_MS=25000

# Force IPv4 for outbound YouTube/video-provider HTTPS requests on Railway
YT_VIDEO_FORCE_IPV4=1

# Video resolver: yt-dlp is primary; Save-Tube fallback is disabled by default.
SAVETUBE_VIDEO_FALLBACK=0
YT_VIDEO_YTDLP_INSPECT_TIMEOUT_MS=20000
YT_VIDEO_RESOLVER_TIMEOUT_MS=24000
