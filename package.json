  "description": "ZUKO first-party API platform with command-style modular endpoints, yt-dlp social downloads, and configurable AI chat",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "check": "node --check index.js && node --check whatsapp.js && node --check config.js && find commands lib web -name \"*.js\" -print0 | xargs -0 -n1 node --check",
